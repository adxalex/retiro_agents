{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(python main.py *)",
      "Bash(python -m scripts.index_corpus *)",
      "Bash(streamlit *)"
    ],
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(git status)",
      "Bash(git diff *)"
    ]
  }
}